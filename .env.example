# Copy to `.env` and fill in. `docker compose up` refuses to start if any of
# the required values below are missing — each one is load-bearing.

# ── Repositories ───────────────────────────────────────────────────────────
# The ONE parent directory holding every repo you want to be able to index. It
# is mounted read-only at /workspaces, and `index_repository` paths are
# relative to it.
#
# The Docker daemon here runs inside WSL, so this is a path in the daemon's
# filesystem: Windows drives appear under /mnt/<drive>.
#
# Examples:
#   REPOS_HOST_PATH=/mnt/f                  # all repos anywhere on F:
#   REPOS_HOST_PATH=/mnt/f/DataPlatform     # just repos under DataPlatform
#   REPOS_HOST_PATH=/home/you/src           # a WSL-native projects folder
#
# Cloning a new repo anywhere under this directory makes it immediately
# indexable — no rebuild, no restart.
REPOS_HOST_PATH=/mnt/f

# ── Postgres ───────────────────────────────────────────────────────────────
# REQUIRED. The graph lives here. The database is never published beyond
# 127.0.0.1 and is never tunnelled; to let a hosted app read the graph
# directly, move it to Supabase (docs/SUPABASE.md).
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=codegraph
# POSTGRES_DB=codegraph

# Optional: keep the graph in a Postgres container you already run for another
# compose project, instead of starting this stack's own. Create the role and
# database there first:  ./scripts/setup_db.sh --docker <container> --create-role
# COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml
# POSTGRES_HOST=data-platform-postgres-1
# EXTERNAL_DB_NETWORK=data-platform_default

# ── Service token ──────────────────────────────────────────────────────────
# REQUIRED. Shared secret for /mcp and /api/* on the code-graph service.
#
# This is the only thing standing between the ngrok URL and your source code:
# /api/file serves files out of REPOS_HOST_PATH, so an untokened tunnel would
# publish everything under it. Generate a real one:
#
#   openssl rand -hex 32
#
# The same value goes in Vercel's environment as CODE_GRAPH_TOKEN.
CODE_GRAPH_TOKEN=

# ── ngrok ──────────────────────────────────────────────────────────────────
# REQUIRED (only if you run the ngrok service). Authtoken from
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional: a reserved domain, so the public URL survives restarts and Vercel's
# MCP_BASE_URL does not have to change every time. Without it ngrok allocates a
# random URL on each start — find it at http://127.0.0.1:4040
# NGROK_DOMAIN=your-name.ngrok.app

# ── App (frontend/) ────────────────────────────────────────────────────────
# REQUIRED. The owner login, until Google/GitHub sign-in replaces it.
#   OWNER_PASSWORD  at least 12 characters
#   SESSION_SECRET  at least 32 characters:  openssl rand -hex 32
OWNER_PASSWORD=
SESSION_SECRET=

# Where preview source text comes from: mcp (the container, default locally),
# github (control.repo_connections, the cloud default) or none.
# SOURCE_PROVIDER=mcp
# Optional: raises GitHub's rate limit and unlocks private repos.
# GITHUB_TOKEN=

# Who answers the app's /api/mcp: native (built in) or proxy (forward to
# MCP_UPSTREAM_URL, e.g. the Python server on a container).
# MCP_BACKEND=native

# Which schema the Python MCP server reads and writes. `public` is the old
# single-tenant layout; tenant_owner matches the cloud layout.
# GRAPH_SCHEMA=public
